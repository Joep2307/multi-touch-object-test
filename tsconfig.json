{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "@biblio": ["./vendor/sturnia-node/api/index.ts"]
    }
  },
  "include": ["src", "vendor/sturnia-node/api"],
  "exclude": ["src/wasm", "src/test", "node_modules", "dist"]
}
