/* Stricter than the rest of the tree, on purpose.
 *
 *   npm run typecheck        the whole repo, as it has always been
 *   npm run typecheck:core   src/core/ only, with the extra flags below
 *
 * The old tree did not survive `noUncheckedIndexedAccess` in one go, so
 * the new core got the strict settings from day one and the rest kept
 * what it had. Most of the gap has since closed — tsconfig.json now has
 * that flag too, and `exactOptionalPropertyTypes` with it. What is left
 * here is the part the app tree cannot have while it draws: `lib` is
 * ES2022 with no DOM and `types` is empty. When the old tree is gone,
 * this file merges back into tsconfig.json.
 *
 * That remainder is the real boundary: the core cannot reach the DOM
 * because the DOM does not exist as far as the compiler is concerned.
 * The ESLint rules in eslint.config.js say the same thing about imports
 * and globals.
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [],
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true
  },
  "include": ["src/core", "src/test/unit/core"],
  "exclude": ["node_modules", "dist"]
}
