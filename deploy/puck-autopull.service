[Unit]
Description=Nieuwe versie van de puck-tafel ophalen en bouwen
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# node/npm staan niet in het magere PATH van een user-unit.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/puck-table.env
ExecStart=%h/.local/bin/puck-autopull.sh
TimeoutStartSec=900
